{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puzzle_catalog.schema.json",
  "title": "NUR puzzle catalog",
  "description": "Contract for assets/content/puzzles/puzzle_catalog.json. Kept deliberately small so src/scripts/validate_content.py can check it with the Python standard library only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["puzzles"],
  "properties": {
    "puzzles": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "difficulty",
          "description",
          "requiredComponents",
          "prefabDependencies",
          "variantParams",
          "unlockCondition",
          "failureState"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^puzzle_[0-9]{3}$"},
          "name": {"type": "string", "minLength": 3},
          "category": {
            "type": "string",
            "enum": [
              "ColorLogic",
              "SequenceMemory",
              "PressurePlate",
              "ShadowAlignment",
              "SoundTrigger",
              "MirrorReflection",
              "SymbolDecoding",
              "TimingWindow",
              "SpatialReasoning",
              "ResourceTrade",
              "Environmental",
              "MemoryPalace"
            ]
          },
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "description": {"type": "string", "minLength": 20},
          "requiredComponents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "prefabDependencies": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "variantParams": {"type": "object", "minProperties": 2},
          "unlockCondition": {"type": "string", "minLength": 5},
          "failureState": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
